<IfModule mod_rewrite.c>
    RewriteEngine On

    # Already inside the public folder's own rewrite (avoid double-processing)
    RewriteCond %{REQUEST_URI} ^/public/
    RewriteRule ^ - [L]

    # Serve everything through the public/ front controller
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
